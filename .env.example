# ============================================================
# Agent Loop 配置（OpenAI 兼容接口）
# 复制本文件为 .env 并填入真实值即可启用真实 LLM。
# 不配置 API Key 时，系统自动回退到 StubLLM（离线演示），
# 同样能完整跑通「思考 → 调工具 → 总结」回路，无需联网/付费。
# ============================================================

# LLM 服务地址（OpenAI 兼容的 chat completions 端点）
# 智谱 GLM:
#   LOOP_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek:
#   LOOP_LLM_BASE_URL=https://api.deepseek.com/v1
# OpenAI:
#   LOOP_LLM_BASE_URL=https://api.openai.com/v1
LOOP_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key（留空则使用 StubLLM 离线演示）
LOOP_LLM_API_KEY=

# 模型名（需与上方服务匹配）
# GLM: glm-4-plus / glm-4-flash ...
# DeepSeek: deepseek-chat / deepseek-reasoner
# OpenAI: gpt-4o-mini / gpt-4o ...
LOOP_LLM_MODEL=glm-4-flash

# 可选：LLM 请求失败重试次数（针对 429/5xx/网络错误，指数退避）
LOOP_LLM_RETRIES=3

# 可选：单次 LLM 请求超时（毫秒），超时自动重试，防止永久卡死
LOOP_LLM_TIMEOUT_MS=30000

# 可选：生成温度
LOOP_LLM_TEMPERATURE=0.3

# 可选：Agent 主循环最大步数（防止无限调用工具）
LOOP_MAX_STEPS=8

# ============================================================
# 上下文工程（自动压缩 / auto-compact）
# 达双重阈值之一即触发：token 占比 或 消息条数。
# 压缩会把中间历史摘要化、保留最近若干条，让长程对话不爆上下文。
# ============================================================
# 模型上下文预算（token）。GLM-4 ≈ 128K，这里留保守默认
LOOP_TOKEN_BUDGET=120000
# token 占比阈值，达此比例则压缩（Claude Code 用 95%，本项目更保守用 85%）
LOOP_COMPACT_THRESHOLD=0.85
# 消息条数兜底阈值（条数过多也触发，即使 token 没超）
LOOP_COMPACT_MAX_MESSAGES=60
# 压缩时保留最近 N 条消息不压缩
LOOP_COMPACT_RECENT=6

# ============================================================
# 流式输出（逐 token）
# ============================================================
# 1=流式输出（默认），0=非流式
LOOP_STREAM=1

# ============================================================
# 可观测性（span 追踪）
# ============================================================
# 1=记录 span 树（默认），0=关闭
LOOP_TRACE=1
# 可选：token 成本估算（每 1K token 的价格），仅用于 /stats 展示
LOOP_PRICE_INPUT_PER_1K=0.0
LOOP_PRICE_OUTPUT_PER_1K=0.0

# ============================================================
# OpenTelemetry 导出（零依赖 OTLP/HTTP）
# 配置端点后，runLoop 的 span 树会导出到任意标准 Collector（Jaeger/Datadog/Honeycomb）。
# ============================================================
# OTLP/HTTP 端点，空=不导出。例如本地 collector：http://localhost:4318/v1/traces
LOOP_OTEL_ENDPOINT=
# 服务名（resource 属性 service.name）
LOOP_OTEL_SERVICE_NAME=agentloop
# 1=runLoop 结束自动导出，0=手动（用 /export-trace）
LOOP_OTEL_EXPORT=0

# ============================================================
# Sub-agent 委派（delegate / delegate_parallel）
# ============================================================
# 子 agent 最大步数（默认 8：经验证 4 步过紧会导致子任务退化为主 agent 手动补救）
LOOP_SUBAGENT_MAX_STEPS=8
# 委派递归深度上限（防止子 agent 无限递归 delegate）
LOOP_SUBAGENT_MAX_DEPTH=3
# 单个子 agent 超时（毫秒），超时该任务失败但不拖垮全局
LOOP_SUBAGENT_TIMEOUT_MS=30000

# ============================================================
# 会话持久化（文件存储）
# ============================================================
# 会话存储目录
LOOP_SESSION_DIR=.agentloop/sessions
# 1=退出 REPL 自动保存
LOOP_SESSION_AUTOSAVE=0

# ============================================================
# 人机协同审批门（Human-in-the-Loop）
# 高风险工具（requiresApproval:true，如 http_get）执行前可暂停、请求人确认。
# ============================================================
# auto=无审批钩子时放行（默认，向后兼容）；strict=无钩子时拒绝高风险工具（更安全）
LOOP_HITL_MODE=auto

# ============================================================
# 执行追踪（轨迹内容捕获 + 持久化 + 评估）
# ============================================================
# 1=runLoop 结束把含内容捕获的完整 trace 落盘，供 /replay /eval 离线使用
LOOP_TRACE_PERSIST=1
# 轨迹存储目录
LOOP_TRACE_DIR=.agentloop/traces
# 评估用的 judge 模型（空=复用主模型 LOOP_LLM_MODEL）
LOOP_EVAL_MODEL=

# ============================================================
# 搜索后端（web_search 工具的多后端抽象）
# auto=自动选最优（有 Tavily key 用 Tavily → 有 Firecrawl key 用 Firecrawl → DDG 兜底）
# 也可显式指定：tavily / firecrawl / ddg
# ============================================================
LOOP_SEARCH_BACKEND=auto
# Tavily（AI 搜索，专为 Agent/RAG 设计，推荐）—— https://app.tavily.com
TAVILY_API_KEY=
# Firecrawl（搜索+抓取，返回完整 markdown）—— https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# ============================================================
# MCP 工具（Model Context Protocol 外部工具集成）
# 配置文件路径（空=不加载 MCP 工具）。指向 mcp-servers.json 或 claude_desktop_config.json
# 配置文件格式见 .agentloop/mcp-servers.json
# ============================================================
LOOP_MCP_CONFIG=

# ============================================================
# 成本预算（Token 上限保护，防长任务费用失控）
# 注意：与上方的 LOOP_TOKEN_BUDGET（上下文预算）不同——
#   LOOP_TOKEN_BUDGET       = 上下文窗口大小（驱动 auto-compact）
#   LOOP_COST_BUDGET_TOKENS = 总花费 token 上限（驱动优雅终止）
# ============================================================
# 总 token 上限（0=不限制）。达此值则 stopReason=budget_exceeded，优雅终止
LOOP_COST_BUDGET_TOKENS=0
# 每 1K token 费用（美元），仅用于展示估算成本
LOOP_COST_BUDGET_PER_K=0
# 预警阈值（占比，0.8=80% 时预警一次）
LOOP_COST_BUDGET_WARNING=0.8
